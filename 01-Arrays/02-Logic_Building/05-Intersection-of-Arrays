class Solution {
    public int[] intersectionArray(int[] nums1, int[] nums2) {
    int n1=nums1.length;
    int n2=nums2.length;
    int visited[]=new int[n2];
    ArrayList<Integer> a=new ArrayList<>();
    for(int i=0;i<n1;i++)
    {
        for(int j=0;j<n2;j++)
        {
          if(nums1[i]==nums2[j]&&visited[j]==0)
          {
            a.add(nums1[i]);
            visited[j]=1;
            break;
          }
        }
    }
    int res[]=new int[a.size()];
    {
        for(int i=0;i<a.size();i++)
        {
          res[i]=a.get(i);
        }
    }
    return res;
    }
}